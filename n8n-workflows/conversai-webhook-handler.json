{
  "name": "ConversAI - Webhook Handler (Leads & Invites)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "conversai-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "conversai-webhook"
    },
    {
      "parameters": {
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "switch-node",
      "name": "Switch by Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [450, 300],
      "parameters": {
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value1": "={{$json.body.type}}",
              "value2": "contact-lead"
            },
            {
              "operation": "equal",
              "value1": "={{$json.body.type}}",
              "value2": "user-invite"
            }
          ]
        },
        "fallbackOutput": 3
      }
    },
    {
      "parameters": {
        "sendTo": "julianocampo@gmail.com",
        "subject": "Nuevo Lead de ConversAI",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; background-color: #f4f4f5; margin: 0; padding: 20px; }\n    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 32px 24px; text-align: center; }\n    .header h1 { color: white; margin: 0; font-size: 24px; font-weight: 600; }\n    .content { padding: 32px 24px; }\n    .info-section { background: #f8fafc; border-left: 4px solid #667eea; padding: 16px; margin: 16px 0; border-radius: 4px; }\n    .info-section h3 { margin: 0 0 12px 0; color: #667eea; font-size: 14px; font-weight: 600; text-transform: uppercase; }\n    .info-item { margin: 8px 0; }\n    .info-label { font-weight: 600; color: #64748b; font-size: 13px; }\n    .info-value { color: #1e293b; font-size: 15px; }\n    .footer { background: #f8fafc; padding: 20px 24px; text-align: center; font-size: 13px; color: #64748b; border-top: 1px solid #e2e8f0; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🎯 Nuevo Lead de ConversAI</h1>\n    </div>\n    <div class=\"content\">\n      <p style=\"margin-top: 0;\">Has recibido un nuevo contacto desde el formulario de ConversAI.</p>\n      \n      <div class=\"info-section\">\n        <h3>Información del Contacto</h3>\n        <div class=\"info-item\">\n          <div class=\"info-label\">Nombre</div>\n          <div class=\"info-value\">{{$json.body.name}}</div>\n        </div>\n        <div class=\"info-item\">\n          <div class=\"info-label\">Email</div>\n          <div class=\"info-value\">{{$json.body.email}}</div>\n        </div>\n        <div class=\"info-item\">\n          <div class=\"info-label\">Teléfono</div>\n          <div class=\"info-value\">{{$json.body.phone || 'No proporcionado'}}</div>\n        </div>\n      </div>\n\n      <div class=\"info-section\">\n        <h3>Mensaje</h3>\n        <div class=\"info-value\">{{$json.body.message}}</div>\n      </div>\n\n      <div class=\"info-section\">\n        <h3>Detalles Adicionales</h3>\n        <div class=\"info-item\">\n          <div class=\"info-label\">Fecha</div>\n          <div class=\"info-value\">{{$now.format('DD/MM/YYYY HH:mm:ss')}}</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"footer\">\n      <p>ConversAI Builder - Sistema de Gestión de Leads</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "gmail-lead-node",
      "name": "Gmail - Send Lead",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [650, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "your-gmail-credential-id",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{$json.body.email}}",
        "subject": "Invitación al equipo de ConversAI",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; background-color: #f4f4f5; margin: 0; padding: 20px; }\n    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 24px; text-align: center; }\n    .header h1 { color: white; margin: 0; font-size: 28px; font-weight: 600; }\n    .header p { color: rgba(255,255,255,0.9); margin: 8px 0 0 0; font-size: 16px; }\n    .content { padding: 40px 32px; }\n    .role-badge { display: inline-block; background: #667eea; color: white; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; margin: 16px 0; }\n    .cta-button { display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 24px 0; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4); transition: transform 0.2s; }\n    .cta-button:hover { transform: translateY(-2px); }\n    .info-box { background: #f8fafc; border-left: 4px solid #667eea; padding: 20px; margin: 24px 0; border-radius: 4px; }\n    .footer { background: #f8fafc; padding: 24px 32px; text-align: center; font-size: 13px; color: #64748b; border-top: 1px solid #e2e8f0; }\n    .footer a { color: #667eea; text-decoration: none; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>✉️ Invitación al Equipo</h1>\n      <p>Has sido invitado a unirte a ConversAI</p>\n    </div>\n    <div class=\"content\">\n      <p style=\"margin-top: 0; font-size: 16px;\">Hola,</p>\n      \n      <p><strong>{{$json.body.invitedBy}}</strong> te ha invitado a unirte al equipo en ConversAI Builder.</p>\n      \n      <div class=\"info-box\">\n        <p style=\"margin: 0; color: #64748b; font-size: 14px;\">Tu rol asignado será:</p>\n        <div class=\"role-badge\">{{$json.body.role}}</div>\n      </div>\n\n      <p>ConversAI Builder es una plataforma para crear y gestionar agentes de WhatsApp con inteligencia artificial. Como miembro del equipo, tendrás acceso a las herramientas necesarias según tu rol.</p>\n\n      <div style=\"text-align: center;\">\n        <a href=\"{{$json.body.inviteUrl}}\" class=\"cta-button\">Aceptar Invitación</a>\n      </div>\n\n      <p style=\"font-size: 14px; color: #64748b; margin-top: 32px;\">\n        Si no esperabas esta invitación, puedes ignorar este email de forma segura.\n      </p>\n    </div>\n    <div class=\"footer\">\n      <p>ConversAI Builder - Sistema de Gestión de Agentes IA</p>\n      <p style=\"margin-top: 8px;\">\n        ¿Problemas con el link? Copia y pega esta URL en tu navegador:<br>\n        <a href=\"{{$json.body.inviteUrl}}\">{{$json.body.inviteUrl}}</a>\n      </p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "gmail-invite-node",
      "name": "Gmail - Send Invite",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [650, 400],
      "credentials": {
        "gmailOAuth2": {
          "id": "your-gmail-credential-id",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Email sent successfully\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "response-success",
      "name": "Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": false, \"message\": \"Invalid request type\" }",
        "options": {
          "responseCode": 400
        }
      },
      "id": "response-error",
      "name": "Response Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 600]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Switch by Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch by Type": {
      "main": [
        [
          {
            "node": "Gmail - Send Lead",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gmail - Send Invite",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Response Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Send Lead": {
      "main": [
        [
          {
            "node": "Response Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Send Invite": {
      "main": [
        [
          {
            "node": "Response Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
