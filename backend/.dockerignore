# ────────────────────────────────────────────────────────────────────────────
# Docker ignore file - Exclude unnecessary files from Docker build context
# ────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist
build
.next
out

# Testing
coverage
.nyc_output
*.spec.ts
*.test.ts
test/
tests/

# Environment variables (NEVER include in image)
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Documentation
README.md
CHANGELOG.md
LICENSE
docs/
*.md

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
logs
*.log

# Misc
.cache
temp
tmp
