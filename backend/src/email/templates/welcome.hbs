    </p>

    <!-- Divider -->
    <div style="height: 1px; background-color: #e5e5e5; margin: 30px 0;"></div>

    <!-- Datos recibidos -->
    <div style="background-color: #f0fdf4; border-left: 4px solid #00D98E; padding: 16px 20px; border-radius: 6px;">
      <p style="margin: 0 0 12px 0; font-size: 15px; font-weight: 600; color: #1a1a1a;">
        Datos que recibimos:
      </p>
      <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">
            📱 Teléfono: {{phone}}
          </td>
        </tr>
        <tr>
          <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">
            📧 Email: {{email}}
          </td>
        </tr>
        <tr>
          <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">
            🆔 Agent ID: {{agentId}}
          </td>
        </tr>
      </table>
    </div>

