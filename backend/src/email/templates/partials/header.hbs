<tr>
  <td style="padding: 0;">
    <table role="presentation" style="width: 100%; border-collapse: collapse; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <tr>
        <td style="padding: 40px 30px; text-align: center;">
          <h1 style="margin: 0 0 10px 0; font-size: 32px; font-weight: 700; color: #ffffff; line-height: 1.2;">
            {{headerTitle}}
          </h1>
          {{#if headerSubtitle}}
          <p style="margin: 0; font-size: 18px; color: rgba(255, 255, 255, 0.95); line-height: 1.4;">
            {{headerSubtitle}}
          </p>
          {{/if}}
        </td>
      </tr>
    </table>
  </td>
</tr>
