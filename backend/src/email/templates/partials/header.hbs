<tr>
  <td style="padding: 0;">
    <table role="presentation" style="width: 100%; border-collapse: collapse; background: linear-gradient(135deg, #00D98E 0%, #00F5A0 100%);">
      <tr>
        <td style="padding: 40px 30px; text-align: center;">
          <div style="background-color: rgba(255, 255, 255, 0.15); width: 56px; height: 56px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
            <span style="font-size: 28px; font-weight: 900; color: #ffffff; letter-spacing: -0.5px;">e</span>
          </div>
          <h1 style="margin: 0 0 4px 0; font-size: 32px; font-weight: 900; color: #ffffff; letter-spacing: -1px;">
            {{headerTitle}}
          </h1>
          {{#if headerSubtitle}}
          <p style="margin: 0; font-size: 14px; color: rgba(255, 255, 255, 0.90); line-height: 1.4; font-weight: 500;">
            {{headerSubtitle}}
          </p>
          {{/if}}
        </td>
      </tr>
    </table>
  </td>
</tr>
