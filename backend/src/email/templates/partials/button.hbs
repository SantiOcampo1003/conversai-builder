<table role="presentation" style="width: 100%; border-collapse: collapse; margin: {{#if margin}}{{margin}}{{else}}20px 0{{/if}};">
  <tr>
    <td align="center">
      <a href="{{url}}"
         style="display: inline-block; padding: 16px 32px; background: linear-gradient(135deg, #00D98E 0%, #00F5A0 100%); color: #ffffff; text-decoration: none; border-radius: 10px; font-size: 16px; font-weight: 600; text-align: center; box-shadow: 0 4px 14px rgba(0, 217, 142, 0.3); letter-spacing: -0.2px;">
        {{text}}
      </a>
    </td>
  </tr>
</table>
