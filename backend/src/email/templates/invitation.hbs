<tr>
  <td style="padding: 48px 40px;">

    <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: 700; color: #1a1d23; letter-spacing: -0.5px;">
      Te han invitado a un equipo 🎉
    </h2>

    <!-- Mensaje principal -->
    <p style="margin: 0 0 24px 0; font-size: 16px; color: #6b7280; line-height: 1.6; font-weight: 400;">
      Has sido invitado a unirte a un equipo en easy AI Agents. Podrás colaborar en la gestión de agentes de IA y acceder a las herramientas del equipo.
    </p>

    <!-- Invite Info Box -->
    <table width="100%" role="presentation" style="border-collapse: collapse; background-color: #f0fdf4; border-radius: 10px; border: 2px solid #00D98E; margin-bottom: 32px;">
      <tr>
        <td style="padding: 24px;">
          <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280; font-weight: 500;">Has sido invitado por:</p>
          <p style="margin: 0 0 16px; font-size: 18px; color: #1a1d23; font-weight: 700;">{{inviterName}}</p>
          <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280; font-weight: 500;">Empresa:</p>
          <p style="margin: 0 0 16px; font-size: 16px; color: #1a1d23; font-weight: 600;">{{inviterCompany}}</p>
          {{#if role}}
          <p style="margin: 0 0 4px; font-size: 14px; color: #6b7280; font-weight: 500;">Rol asignado:</p>
          <p style="margin: 0; font-size: 16px; color: #00D98E; font-weight: 600; text-transform: capitalize;">{{role}}</p>
          {{/if}}
        </td>
      </tr>
    </table>

    <p style="margin: 0 0 32px; font-size: 16px; color: #6b7280; line-height: 1.6; font-weight: 400;">
      Haz clic en el botón de abajo para aceptar la invitación y unirte al equipo:
    </p>

    <!-- Botón CTA -->
    {{> button url=invitationUrl text="Aceptar Invitación" margin="0 0 32px 0"}}

    <!-- Instrucciones alternativas -->
    <p style="margin: 0 0 8px; font-size: 14px; color: #9ca3af; font-weight: 500;">
      O copia y pega este enlace en tu navegador:
    </p>
    <p style="margin: 0 0 32px; font-size: 13px; color: #00D98E; background-color: #f3f4f6; padding: 12px 16px; border-radius: 8px; font-weight: 500; word-break: break-all;">
      {{invitationUrl}}
    </p>

    <!-- Info Box -->
    <table width="100%" role="presentation" style="border-collapse: collapse; background-color: #eff6ff; border-radius: 8px; border-left: 3px solid #3b82f6;">
      <tr>
        <td style="padding: 16px 20px;">
          <p style="margin: 0; font-size: 14px; color: #1e40af; line-height: 1.5; font-weight: 500;">
            <strong style="font-weight: 700;">💡 Nota:</strong> Si no esperabas esta invitación o no conoces al remitente, puedes ignorar este email de forma segura.
          </p>
        </td>
      </tr>
    </table>

  </td>
</tr>
