# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# OpenAI
OPENAI_API_KEY=sk-proj-xxx...

# Token Pricing
# Porcentaje de markup sobre tokens de OpenAI (100 = cobrar el doble, 50 = cobrar 1.5x)
TOKEN_MARKUP_PERCENTAGE=100

# Agent Execution Limits (para prevenir loops infinitos y sobrecostos)
# Tiempo máximo de ejecución en milisegundos (30000 = 30 segundos)
AGENT_MAX_EXECUTION_TIME=30000

# Meta Ads Integration
# Clave de encriptacion para tokens de Meta Ads (32 bytes en hexadecimal = 64 caracteres)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=123

# Email Configuration (Gmail SMTP)
# Para Gmail: Debes crear una "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
# NO uses tu contraseña normal de Gmail
SMTP_USER=easy.development.tech@gmail.com
SMTP_PASSWORD="xxxx"
SMTP_FROM_NAME=Easy Agents


# Optional: LangSmith (para debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxx
# LANGCHAIN_PROJECT=conversai-builder
