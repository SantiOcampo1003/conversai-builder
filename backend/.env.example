# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# OpenAI
# Modelo por defecto cuando el agente no define uno (agents.model). Si se omite: gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini
# Temperatura por defecto (0 a 2). Si se omite: 0.3
# OPENAI_TEMPERATURE=0.3
# Mensajes de historial que ve el modelo en cada respuesta (1 a 100). Si se omite: 30
# CHAT_HISTORY_LIMIT=30
OPENAI_API_KEY=sk-proj-xxx...

# Token Pricing
# Porcentaje de markup sobre tokens de OpenAI (100 = cobrar el doble, 50 = cobrar 1.5x)
TOKEN_MARKUP_PERCENTAGE=100

# Agent Execution Limits (para prevenir loops infinitos y sobrecostos)
# Tiempo máximo de ejecución en milisegundos (30000 = 30 segundos)
AGENT_MAX_EXECUTION_TIME=30000

# Meta Ads Integration
# Clave de encriptacion para tokens de Meta Ads (32 bytes en hexadecimal = 64 caracteres)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=123

# Email Configuration (Gmail SMTP)
# Para Gmail: Debes crear una "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
# NO uses tu contraseña normal de Gmail
SMTP_USER=easy.development.tech@gmail.com
SMTP_PASSWORD="xxxx"
SMTP_FROM_NAME=Easy Agents


# Optional: LangSmith (para debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxx
# LANGCHAIN_PROJECT=conversai-builder

# Google Sheets (opcional): JSON de la cuenta de servicio de Google (texto JSON o en base64).
# Sin esto la integración con Google Sheets queda desactivada; el chat funciona igual.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Imprime en los logs el prompt completo de cada mensaje (incluye datos de la persona). Solo para depurar.
LOG_SYSTEM_PROMPT=false

# Envío de avisos por WhatsApp desde el backend (misma API de Evolution que usa n8n).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Extractor de datos (guarda lo que la persona dice antes de que el agente responda). "off" lo desactiva.
DATA_EXTRACTOR=on
